flowchart TD
    A[An Employee Logs In] -->|Employee Account| B[View Repair Backlog]
    B --> C{Select Bike to Repair}
    C -->|Choose Bike| D[View Bike Details]
    D --> E[Search for Needed Parts]
    E --> F[View Part Info & Vendor Links]
    F --> G{Parts in Stock?}
    G -->|No| H[Order from Vendor]
    H --> I[Set Bike Status: Waiting on Parts]
    I --> J[Return to Repair Backlog]
    J --> C
    G -->|Yes| K[Install Parts & Repair]
    K --> L{Repair Complete?}
    L -->|No| E
    L -->|Yes| M[Reactivate Bike]
    M --> N[Add to Rental Catalogue]
    N --> O[Bike Ready for Rental]
    O --> P{More Bikes?}
    P -->|Yes| C
    P -->|No| Q[End Session]
    
    classDef login fill:#eef2ff,stroke:#818cf8
    classDef backlog fill:#f0f9ff,stroke:#38bdf8
    classDef search fill:#f0fdfa,stroke:#2dd4bf
    classDef waiting fill:#fff7ed,stroke:#fb923c
    classDef action fill:#f0fdf4,stroke:#4ade80
    classDef complete fill:#fef2f2,stroke:#f87171
    
    class A login
    class B,C,J backlog
    class E,F,H search
    class I waiting
    class K,M,N action
    class O,Q complete